{{/preferPooled}}
PGDATABASE='{{{pgEncodedDatabase}}}'
PGUSER='{{{pgRole}}}'
{{#pgPasswordOrPlaceholder}}PGPASSWORD='{{{pgPasswordOrPlaceholder}}}'{{/pgPasswordOrPlaceholder}}
PGSSLMODE='require'
{{#channelBinding}}PGCHANNELBINDING='require'{{/channelBinding}}
`,yZ=`// prisma/schema.prisma
